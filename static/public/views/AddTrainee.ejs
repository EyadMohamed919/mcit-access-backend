<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>إضافة سجل متدربين / مستفيدين</title>
    <link rel="stylesheet" href="/styles/DashboardStyles.css">
    <link rel="stylesheet" href="/styles/AddProjectStyles.css">
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item active" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item" href="/TrainingPrograms">البرامج التدريبية Training Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item" href="/Outputs">المخرجات Outputs</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>
    <main class="main-content" style="margin: 0 auto; max-width: 900px; padding: 20px;">
        <header class="top-bar">
            <h1 class="page-title">إضافة سجل مستفيدين جديد</h1>
            <a href="/Trainees" class="back-link">← العودة للسجل</a>
        </header>

        <section class="form-container">
            <form action="/api/trainee/AddTrainee" method="POST" class="app-form">
                
                <div class="form-section-title">بيانات البرنامج والمكان</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="prog_ID">البرنامج التدريبي (Training Program)<span class="required">*</span></label>
                        <select id="prog_ID" name="prog_ID">
                            <% trainingPrograms.forEach(function(trainingProgram) { %>
                            <option value='<%= trainingProgram.prog_ID %>' ><%= trainingProgram.prog_title %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="prog_date">تاريخ البرنامج</label>
                        <input type="date" id="prog_date" name="prog_date">
                    </div>
                    <div class="form-group">
                        <label for="training_center">مركز التدريب (Training Center)</label>
                        <input type="text" id="training_center" name="training_center">
                    </div>

                    <div class="form-group">
                        <label for="gov_id">المحافظة (Governorate)<span class="required">*</span></label>
                        <select id="gov_id" name="gov_id">
                            <% govs.forEach(function(gov) { %>
                            <option value='<%= gov.gov_id %>' ><%= gov.gov_name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div class="form-section-title">إحصائيات المستفيدين</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="ben_enrolled">إجمالي المسجلين (Enrolled)</label>
                        <input type="number" min="0" id="ben_enrolled" name="ben_enrolled">
                    </div>
                    <div class="form-group">
                        <label for="ben_completed">إجمالي المجتازين (Completed)</label>
                        <input type="number" min="0" id="ben_completed" name="ben_completed">
                    </div>
                    <div class="form-group">
                        <label for="ben_male">عدد الذكور</label>
                        <input type="number" min="0" id="ben_male" name="ben_male">
                    </div>
                    <div class="form-group">
                        <label for="ben_female">عدد الإناث</label>
                        <input type="number" min="0" id="ben_female" name="ben_female">
                    </div>
                    <div class="form-group">
                        <label for="ben_retention">الاحتفاظ (Retention)</label>
                        <input type="number" min="0" id="ben_retention" name="ben_retention">
                    </div>
                </div>

                <div class="form-section-title">ذوي الإعاقة والمدربين</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="ben_pwd">عدد ذوي الإعاقة (PWD)</label>
                        <input type="number" min="0" id="ben_pwd" name="ben_pwd">
                    </div>
                    <div class="form-group">
                        <label for="type_of_disability">نوع الإعاقة</label>
                        <input type="text" id="type_of_disability" name="type_of_disability">
                    </div>
                    <div class="form-group">
                        <label for="ben_trainer_id">معرف المدرب (Trainer ID)</label>
                        <input type="number" min="0" id="ben_trainer_id" name="ben_trainer_id">
                    </div>
                    <div class="form-group">
                        <label for="name_trainers">اسم المدرب (Trainer's Name)</label>
                        <input type="text" id="name_trainers" name="name_trainers">
                    </div>
                </div>

                <div class="form-section-title">معرفات الربط الإضافية</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="out_id">معرف المخرج (Output ID)</label>
                        <input type="number" min="0" id="out_id" name="out_id">
                    </div>
                    <div class="form-group">
                        <label for="tainee_type_id">نوع المتدرب (Trainee Type ID)</label>
                        <input type="number" min="0" id="tainee_type_id" name="tainee_type_id">
                    </div>
                    <div class="form-group">
                        <label for="Age_Group_ID">الفئة العمرية (Age Group ID)</label>
                        <input type="number" min="0" id="Age_Group_ID" name="Age_Group_ID">
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-primary">حفظ البيانات</button>
                    <a href="/Trainees" class="btn-secondary">إلغاء</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>