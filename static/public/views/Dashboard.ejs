<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - وزارة اتصالات وتكنولوجيا المعلومات</title>
    <link rel="stylesheet" href="../styles/DashboardStyles.css">
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item active" href="/dashboard">المشاريع</a>
            <a class="nav-item" href="/events">الفعاليات</a>
            <a class="nav-item" href="/trainees">المتدربين</a>
            <a class="nav-item" href="/products">المنتجات</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 class="page-title">مشاريع المستخدم</h1>
            <div class="user-badge">
                <span class="user-name">مرحباً، <%=  username + 'المستخدم' %></span>
            </div>
        </header>

        <section class="stats-overview">
            <div class="stat-card">
                <span class="stat-label">إجمالي المشاريع</span>
                <span class="stat-value"><%= projects ? projects.length : 0 %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">الفعاليات المرتبطة</span>
                <span class="stat-value"><%= stats ? stats.totalEvents : 0 %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">إجمالي المتدربين</span>
                <span class="stat-value"><%= stats ? stats.totalTrainees : 0 %></span>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <h2>قائمة المشاريع الحالية</h2>
                <a class="action-btn" href="/projects/new">+ إضافة مشروع جديد</a>
            </div>

            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>معرف المشروع</th>
                            <th>اسم المشروع</th>
                            <th>تاريخ البدء</th>
                            <th>تاريخ الانتهاء</th>
                            <th>المرحلة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (projects && projects.length > 0) { %>
                            <% projects.forEach(function(project) { %>
                                <tr>
                                    <td>#<%= project.pr_ID %></td>
                                    <td class="font-bold"><%= project.Pr_title || project.pr_title_en %></td>
                                    <td><%= project.pr_StartDatedate ? new Date(project.pr_StartDatedate).toLocaleDateString('ar-EG') : '-' %></td>
                                    <td><%= project.pr_EndDate ? new Date(project.pr_EndDate).toLocaleDateString('ar-EG') : '-' %></td>
                                    <td><span class="badge">المرحلة <%= project.pr_PhaseNo || 1 %></span></td>
                                    <td class="actions-cell">
                                        <a class="table-link" href="/projects/<%= project.pr_ID %>">عرض</a>
                                        <a class="table-link edit" href="/projects/<%= project.pr_ID %>/edit">تعديل</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="empty-state">لا توجد مشاريع مسجلة حالياً.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>