<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تعديل المخرج - وزارة الاتصالات وتكنولوجيا المعلومات</title>
    <link rel="stylesheet" href="/styles/DashboardStyles.css">
    <link rel="stylesheet" href="/styles/AddProjectStyles.css">
</head>
<body>
    <div id="global-loader" class="loader-overlay hidden">
        <div class="spinner"></div>
    </div>
    <script src="../scripts/loading.js"></script>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" height="100px" src="../media/MainLogo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item" href="/TrainingPrograms">البرامج التدريبية Training Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item active" href="/Outputs">المخرجات Outputs</a>

            <a class="nav-item" href="/Settings" style="margin-top: 20px;">الإعدادات Settings</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 class="page-title">تعديل بيانات المخرج (Output)</h1>
            <a href="/Outputs" class="back-link">← العودة للمخرجات</a>
        </header>

        <section class="form-container">
            <form action="/api/outputs/EditOutput" method="POST" class="app-form">
                
                <input type="number" id="out_ID" name="out_ID" hidden value="<%= output.out_ID %>">

                <div class="form-section-title">بيانات المخرج الأساسية (Output)</div>
                
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label for="out_title">اسم المخرج (عربي) <span class="required">*</span></label>
                        <% if(isAdmin){ %>
                            <input type="text" id="out_title" name="out_title" required value="<%= output.out_title %>">
                        <% }else{ %>
                            <select id="out_title" name="out_title" required>
                                <% arabicTitles.forEach(function(title) { %>
                                    <% if (output.out_title == title) { %>
                                        <option value="<%= title %>" selected><%= title %></option>
                                    <% } else { %>
                                        <option value="<%= title %>"><%= title %></option>
                                    <% } %>
                                <% }); %>
                            </select>
                        <% } %>
                    </div>

                    <div class="form-group full-width">
                        <label for="out_title_en">اسم المخرج (إنجليزي)</label>
                        <% if(isAdmin){ %>
                            <input type="text" id="out_title_en" name="out_title_en" value="<%= output.out_title_en %>" dir="ltr">
                        <% }else{ %>
                            <select id="out_title_en" name="out_title_en" required dir="ltr">
                                <% englishTitles.forEach(function(title) { %>
                                    <% if (output.out_title_en == title) { %>
                                        <option value="<%= title %>" selected><%= title %></option>
                                    <% } else { %>
                                        <option value="<%= title %>"><%= title %></option>
                                    <% } %>
                                <% }); %>
                            </select>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="pr_ID">المشروع (Project) <span class="required">*</span></label>
                        <select id="pr_ID" name="pr_ID" required>
                            <% projects.forEach(function(project) { 
                                const projectID = project["Projects.pr_ID"] || project.pr_ID || project.pr_id;
                            %>
                                <% if (Number(output.pr_ID) === Number(projectID)) { %>
                                    <option value="<%= projectID %>" selected><%= project.Pr_title || project.pr_title %></option>
                                <% } else { %>
                                    <option value="<%= projectID %>"><%= project.Pr_title || project.pr_title %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="protocol_id">معرف البروتوكول (Protocol)</label>
                        <select id="protocol_id" name="protocol_id" required>
                            <% protocols.forEach(function(protocol) { %>
                                <% if (Number(output.protocol_id) === Number(protocol.protocol_id)) { %>
                                    <option value="<%= protocol.protocol_id %>" selected><%= protocol.pro_title %></option>
                                <% } else { %>
                                    <option value="<%= protocol.protocol_id %>"><%= protocol.pro_title %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <% 
                        // Format dates for HTML date inputs
                        let formattedStart = '', formattedEnd = '';
                        if (output.start_date && !isNaN(new Date(output.start_date).getTime())) {
                            formattedStart = new Date(output.start_date).toISOString().split('T')[0];
                        }
                        if (output.end_date && !isNaN(new Date(output.end_date).getTime())) {
                            formattedEnd = new Date(output.end_date).toISOString().split('T')[0];
                        }
                    %>

                    <div class="form-group">
                        <label for="start_date">تاريخ البداية</label>
                        <input type="date" id="start_date" name="start_date" required value="<%= formattedStart %>">
                    </div>

                    <div class="form-group">
                        <label for="end_date">تاريخ النهاية</label>
                        <input type="date" id="end_date" name="end_date" required value="<%= formattedEnd %>">
                    </div>
                </div>

                <div class="form-section-title">مؤشرات الأداء والأنواع</div>

                <div class="form-grid">
                    <div class="form-group">
                        <label for="out_target">الهدف المستهدف (Target)</label>
                        <input type="text" id="out_target" name="out_target" required value="<%= output.out_target %>">
                    </div>

                    <div class="form-group">
                        <label for="out_baseline">خط الأساس (Baseline)</label>
                        <input type="number" id="out_baseline" name="out_baseline" required value="<%= output.out_baseline || 0 %>">
                    </div>

                    <div class="form-group">
                        <label for="out_type_id">معرف نوع المخرج (Output Type ID)</label>
                        <select id="out_type_id" name="out_type_id" required>
                            <% types.forEach(function(type) { %>
                                <% if (Number(output.out_type_id) === Number(type.type_id)) { %>
                                    <option value="<%= type.type_id %>" selected><%= type.type_title %></option>
                                <% } else { %>
                                    <option value="<%= type.type_id %>"><%= type.type_title %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-primary">حفظ التعديلات</button>
                    <a href="/Outputs" class="btn-secondary">إلغاء</a>
                </div>
            </form>
        </section>
    </main>

</body>
</html>