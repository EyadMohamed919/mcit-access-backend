<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تعديل منتج</title>
    <link rel="stylesheet" href="/styles/DashboardStyles.css">
    <link rel="stylesheet" href="/styles/AddProjectStyles.css">
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item" href="/TrainingPrograms">البرامج التدريبية Training Programs</a>
            <a class="nav-item active" href="/Products">المنتجات Products</a>
            <a class="nav-item" href="/Outputs">المخرجات Outputs</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>
    
    <main class="main-content" style="margin: 0 auto; max-width: 900px; padding: 20px;">
        <header class="top-bar">
            <h1 class="page-title">تعديل المنتج</h1>
            <a href="/Products" class="back-link">← (Products) العودة للمنتجات</a>
        </header>

        <section class="form-container">
            <form action="/api/products/EditProduct" method="POST" class="app-form">
                
                <!-- Hidden Field for Product ID -->
                <input type="number" id="prod_id" name="prod_id" hidden value="<%= product.prod_id %>">

                <div class="form-section-title">البيانات الأساسية للمنتج (Product)</div>
                <div class="form-grid">
                    
                    <div class="form-group full-width">
                        <label for="prod_title">اسم المنتج (عربي) <span class="required">*</span></label>
                        <% if(isAdmin){ %>
                            <input required type="text" id="prod_title" name="prod_title" value="<%= product.prod_title %>">
                        <% }else{ %>
                            <select id="prod_title" name="prod_title" required>
                                <% arabicTitles.forEach(function(title) { %>
                                    <% if (product.prod_title == title) { %>
                                        <option value="<%= title %>" selected><%= title %></option>
                                    <% } else { %>
                                        <option value="<%= title %>"><%= title %></option>
                                    <% } %>
                                <% }); %>
                            </select>
                        <% } %>
                    </div>
                    
                    <div class="form-group full-width">
                        <label for="prod_title_en">اسم المنتج (إنجليزي) (Product)</label>
                        <% if(isAdmin){ %>
                            <input type="text" id="prod_title_en" dir="ltr" name="prod_title_en" value="<%= product.prod_title_en %>">
                        <% }else{ %>
                            <select id="prod_title_en" name="prod_title_en" dir="ltr">
                                <option value="">بدون اسم إنجليزي</option>
                                <% englishTitles.forEach(function(title) { %>
                                    <% if (product.prod_title_en == title) { %>
                                        <option value="<%= title %>" selected><%= title %></option>
                                    <% } else { %>
                                        <option value="<%= title %>"><%= title %></option>
                                    <% } %>
                                <% }); %>
                            </select>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label for="pr_id">المشروع المرتبط (Project ID) <span class="required">*</span></label>
                        <select id="pr_id" name="pr_id" required>
                            <% projects.forEach(function(project) { 
                                const projectID = project["Projects.pr_ID"] || project.pr_ID || project.pr_id;
                            %>
                                <% if (Number(product.pr_id) === Number(projectID)) { %>
                                    <option value="<%= projectID %>" selected><%= project.Pr_title || project.pr_title %></option>
                                <% } else { %>
                                    <option value="<%= projectID %>"><%= project.Pr_title || project.pr_title %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="out_id">المخرج المرتبط (Output ID)</label>
                        <select id="out_id" name="out_id">
                            <option value="">-- بدون مخرج --</option>
                            <% if (outputs && outputs.length > 0) { %>
                                <% outputs.forEach(function(output) { %>
                                    <% if (Number(product.out_id) === Number(output.out_ID)) { %>
                                        <option value='<%= output.out_ID %>' selected><%= output.out_title %></option>
                                    <% } else { %>
                                        <option value='<%= output.out_ID %>'><%= output.out_title %></option>
                                    <% } %>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group full-width">
                        <label for="prod_desc">وصف المنتج (Description)</label>
                        <textarea id="prod_desc" name="prod_desc" rows="4"><%= product.prod_desc %></textarea>
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-primary">حفظ التعديلات</button>
                    <a href="/Products" class="btn-secondary">إلغاء</a>
                </div>
            </form>
        </section>
    </main>
</body>
</html>