<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>تعديل سجل متدربين / مستفيدين</title>
    <link rel="stylesheet" href="/styles/DashboardStyles.css">
    <link rel="stylesheet" href="/styles/AddProjectStyles.css">
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item active" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item" href="/TrainingPrograms">البرامج التدريبية Training Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item" href="/Outputs">المخرجات Outputs</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>
    <main class="main-content" style="margin: 0 auto; max-width: 900px; padding: 20px;">
        <header class="top-bar">
            <h1 class="page-title">تعديل سجل المستفيدين</h1>
            <a href="/Trainees" class="back-link">← العودة للسجل</a>
        </header>

        <section class="form-container">
            <form action="/api/trainee/EditTrainee" method="POST" class="app-form">
                
                <!-- Hidden ID Field -->
                <input type="number" hidden id="ben_id" name="ben_id" value="<%= trainee.ben_id %>">

                <div class="form-section-title">بيانات البرنامج والمكان</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="prog_ID">البرنامج التدريبي (Training Program)<span class="required">*</span></label>
                        <select id="prog_ID" name="prog_ID">
                            <% trainingPrograms.forEach(function(trainingProgram) { %>
                                <% if (Number(trainee.prog_ID) === Number(trainingProgram.prog_ID)) { %>
                                    <option value='<%= trainingProgram.prog_ID %>' selected><%= trainingProgram.prog_title %></option>
                                <% } else { %>
                                    <option value='<%= trainingProgram.prog_ID %>'><%= trainingProgram.prog_title %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="prog_date">تاريخ البرنامج</label>
                        <% 
                            // Format date to YYYY-MM-DD safely
                            let formattedDate = '';
                            if (trainee && trainee.prog_date) {
                                const d = new Date(trainee.prog_date);
                                if (!isNaN(d.getTime())) {
                                    formattedDate = d.toISOString().split('T')[0];
                                }
                            }
                        %>
                        <input type="date" id="prog_date" name="prog_date" value="<%= formattedDate %>">
                    </div>

                    <div class="form-group">
                        <label for="training_center">مركز التدريب (Training Center)</label>
                        <!-- <input type="text" id="training_center" name="training_center"> -->
                        <select id="training_center" name="training_center" required>
                            
                            <% centers.forEach(function(center) { %>
                                <% if (trainee["Training Center"] == center) { %>
                                <option  value='<%= center %>' selected><%= center %></option>
                                <% } else { %>
                                <option  value='<%= center %>' ><%= center %></option>
                            <% }}); %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="gov_id">المحافظة (Governorate)<span class="required">*</span></label>
                        <select id="gov_id" name="gov_id">
                            <% govs.forEach(function(gov) { %>
                                <% if (Number(trainee.gov_id) === Number(gov.gov_id)) { %>
                                    <option value='<%= gov.gov_id %>' selected><%= gov.gov_name %></option>
                                <% } else { %>
                                    <option value='<%= gov.gov_id %>'><%= gov.gov_name %></option>
                                <% } %>
                            <% }); %>
                        </select>
                    </div>
                </div>

                <div class="form-section-title">إحصائيات المستفيدين</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="ben_enrolled">إجمالي المسجلين (Enrolled)</label>
                        <input type="number" min="0" id="ben_enrolled" name="ben_enrolled" value="<%= trainee.ben_enrolled || 0 %>">
                    </div>
                    <div class="form-group">
                        <label for="ben_completed">إجمالي المجتازين (Completed)</label>
                        <input type="number" min="0" id="ben_completed" name="ben_completed" value="<%= trainee.ben_completed || 0 %>">
                    </div>
                    <div class="form-group">
                        <label for="ben_male">عدد الذكور</label>
                        <input type="number" min="0" id="ben_male" name="ben_male" value="<%= trainee.ben_male || 0 %>">
                    </div>
                    <div class="form-group">
                        <label for="ben_female">عدد الإناث</label>
                        <input type="number" min="0" id="ben_female" name="ben_female" value="<%= trainee.ben_female || 0 %>">
                    </div>
                    <div class="form-group">
                        <label for="ben_retention">الاحتفاظ (Retention)</label>
                        <input type="number" min="0" id="ben_retention" name="ben_retention" value="<%= trainee.ben_retention || 0 %>">
                    </div>
                </div>

                <div class="form-section-title">ذوي الإعاقة والمدربين</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="ben_pwd">عدد ذوي الإعاقة (PWD)</label>
                        <input type="number" min="0" id="ben_pwd" name="ben_pwd" value="<%= trainee.ben_pwd || 0 %>">
                    </div>
                    <div class="form-group">
                        <label for="type_of_disability">نوع الإعاقة</label>
                        <input type="text" id="type_of_disability" name="type_of_disability" value="<%= trainee['Type of disability'] || '' %>">
                    </div>
                   
                    <div class="form-group">
                        <label for="name_trainers">اسم المدرب (Trainer's Name)</label>
                        <input type="text" id="name_trainers" name="name_trainers" value="<%= trainee["name Trainer's"] || '' %>">
                    </div>
                </div>

                <div class="form-section-title">معرفات الربط الإضافية</div>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="out_id">المخرج (Output)</label>
                        <% if (outputs && outputs.length > 0) { %>
                            <select name="out_id" id="out_id">

                            <% outputs.forEach(function(output) { %>
                                <% if (trainee.out_id == output.out_ID) { %>
                                    
                                <option value='<%= output.out_ID %>' selected><%= output.out_title %></option>
                                <% } else { %>
                                    <option value='<%= output.out_ID %>'> <%= output.out_title %></option>
                                <% }}); %>
                            </select>
                        <% } else { %>
                            <select name="out_id" id="out_id">
                                <option value="" disabled selected>لا توجد أي مخرجات حالياََ</option>
                            </select>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label for="tainee_type_id">نوع المتدرب (Trainee Type)</label>
                        <!-- <input type="number" min="0" id="tainee_type_id" name="tainee_type_id" value="<%= trainee.tainee_type_id || '' %>"> -->
                        
                        <select id="tainee_type_id" name="tainee_type_id" required>
                            <% traineeTypes.forEach(function(type) { %>
                                <% if (trainee.type_id == type.type_id) { %>
                                    <option  value='<%= type.type_id %>' selected><%= type.type_title %></option>
                                <% } else { %>
                                    <option  value='<%= type.type_id %>' ><%= type.type_title %></option>
                            <% }}); %>
                        </select>

                    </div>
                    <div class="form-group">
                        <label for="Age_Group_ID">الفئة العمرية (Age Group ID)</label>
                        <!-- <input type="number" min="0" id="Age_Group_ID" name="Age_Group_ID" value="<%= trainee.Age_Group_ID || '' %>"> -->
                        <select id="Age_Group_ID" name="Age_Group_ID" required>
                            <% ageGroups.forEach(function(age) { %>
                                <% if (trainee.Age_Group_ID == age.type_id) { %>
                                    <option  value='<%= age.type_id %>' selected><%= age.type_title %></option>
                                <% } else { %>
                                    <option  value='<%= age.type_id %>' ><%= age.type_title %></option>
                            <% }}); %>
                        </select>
                    </div>
                </div>

                <div class="form-actions" style="margin-top: 20px;">
                    <button type="submit" class="btn-primary">حفظ التعديلات</button>
                    <a href="/Trainees" class="btn-secondary">إلغاء</a>
                </div>
                
            </form>
        </section>
    </main>
</body>
</html>