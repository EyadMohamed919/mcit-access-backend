<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الفعاليات - وزارة الاتصالات وتكنولوجيا المعلومات</title>
    <link rel="stylesheet" href="../styles/DashboardStyles.css">
    <link rel="stylesheet" href="../styles/EventStyle.css">
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item active" href="/Events">الفعاليات Events</a>
            <a class="nav-item" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item " href="/TrainingPrograms">البرامج التدريبية Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item" href="/Outputs">المخارج Outputs</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 class="page-title">إدارة الفعاليات لمشروع: <label for=""><%= projectTitle %></label></h1>
            <div class="user-badge">
                <span class="user-name">مرحباً، <%=  username + 'المستخدم' %></span>
            </div>
        </header>

        <section class="stats-overview">
            <div class="stat-card">
                <span class="stat-label">إجمالي الفعاليات</span>
                <span class="stat-value"><%= events ? events.length : 0 %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">إجمالي الحضور</span>
                <span class="stat-value"><%= stats ? stats.totalAttendees : 0 %></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">المحافظات المغطاة</span>
                <span class="stat-value"><%= stats ? stats.totalGovs : 0 %></span>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <h2>سجل الفعاليات التفصيلي</h2>
                <a class="action-btn" href="/AddEvent">+ إضافة فعالية جديدة</a>
            </div>

            <div class="table-wrapper full-scroll">
                <table class="data-table wide-table">
                    <thead>
                        <tr>
                            <th>معرف الفعالية</th>
                            <th>اسم الفعالية (عربي)</th>
                            <th>اسم الفعالية (إنجليزي)</th>
                            <th>معرف المشروع</th>
                            <th>تاريخ الفعالية</th>
                            <th>الوصف</th>
                            <th>المخرج (Output ID)</th>
                            <th>عدد الحضور</th>
                            <th>إناث</th>
                            <th>ذكور</th>
                            <th>المحافظة (Gov ID)</th>
                            <th>الفئة العمرية (Age Group ID)</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (events && events.length > 0) { %>
                            <% events.forEach(function(event) { %>
                                <tr>
                                    <td>#<%= event.event_id %></td>
                                    <td class="font-bold whitespace-nowrap"><%= event.event_name || '-' %></td>
                                    <td class="whitespace-nowrap"><%= event.event_name_en || '-' %></td>
                                    <td><a class="table-link" href="/projects/<%= event.pr_id %>">#<%= event.pr_id %></a></td>
                                    <td class="whitespace-nowrap"><%= event.event_Date ? new Date(event.event_Date).toLocaleDateString('en-UK') : '-' %></td>
                                    <td class="cell-desc" title="<%= event.event_desc %>"><%= event.event_desc || '-' %></td>
                                    <td><%= event.out_id || '-' %></td>
                                    <td><span class="badge"><%= event.ben_no || 0 %></span></td>
                                    <td><%= event.ben_female || 0 %></td>
                                    <td><%= event.ben_male || 0 %></td>
                                    <td><%= event.gov_id || '-' %></td>
                                    <td><%= event.Age_Group_ID || '-' %></td>
                                    <td class="actions-cell whitespace-nowrap">
                                        <a class="table-link edit" href="/AddEvent/<%= event.event_id %>">تعديل</a>
                                        <form action="/api/event/DeleteEvent" method="post">
                                            <input hidden type="number" name="eventID" value="<%= event.event_id %>">
                                            <button class="table-link">حذف</button>
                                        </form>
                                        <a class="table-link" href=>حذف</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="13" class="empty-state">لا توجد فعاليات مسجلة حالياً.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>