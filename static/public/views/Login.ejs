<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="../styles/LoginStyle.css">
    <link rel="stylesheet" href="../styles/GlobalStyles.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>وزارة الاتصالات وتكنولوجيا المعلومات - تسجيل الدخول</title>
</head>
<body>

<div class="login-container">
    <div class="logo-section">
        <svg class="mcit-logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M50 5L10 25V55C10 75 50 95 50 95C50 95 90 75 90 55V25L50 5Z" stroke="#d32f2f" stroke-width="3" fill="#ffffff"/>
            <path d="M50 15L20 30V52C20 68 50 83 50 83C50 83 80 68 80 52V30L50 15Z" fill="#d32f2f"/>
            <path d="M50 25L30 35V50C30 60 50 72 50 72C50 72 70 60 70 50V35L50 25Z" fill="#ffffff"/>
        </svg>
        <h1 class="logo-title">وزارة الاتصالات وتكنولوجيا المعلومات</h1>
        <%= hostData %>
    </div>

    <div class="form-section">
        <form class="login-form">
            <h2 class="form-title">تسجيل الدخول</h2>
            <div class="field-group">
                <label class="field-label" for="email">اسم المستخدم</label>
                <input class="form-input" type="email" id="email" required>
            </div>

            <div class="field-group">
                <label class="field-label" for="password">كلمة المرور</label>
                <input class="form-input" type="password" id="password" required>
            </div>

            <button class="submit-btn" type="submit">تسجيل الدخول</button>
        </form>
    </div>

    
</div>

<footer>
    <h4>ادخل على الموقع من خلال الرابط التالي</h4>
    <a href="<%= hostData %>"><%= hostData %></a>
</footer>
</body>
</html>