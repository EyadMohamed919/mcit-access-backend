<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="../styles/LoginStyle.css">
    <link rel="stylesheet" href="../styles/GlobalStyles.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>وزارة الاتصالات وتكنولوجيا المعلومات - تسجيل الدخول</title>
</head>
<body>

<div id="global-loader" class="loader-overlay hidden">
    <div class="spinner"></div>
</div>
<script src="../scripts/loading.js"></script>

<div class="login-container">
    <div class="logo-section">
        <img src="../media/MainLogo.png" alt="">
        <!-- <h1 class="logo-title">وزارة الاتصالات وتكنولوجيا المعلومات</h1> -->
        <!-- <%= hostData %> -->
    </div>

    <div class="form-section">
        <form class="login-form" method="post" action="<%= hostData %>/api/users/login">
            <h2 class="form-title">تسجيل الدخول</h2>
            <div class="field-group">
                <label class="field-label" for="name">اسم المستخدم</label>
                <input class="form-input" type="text" id="name" name="name" required>
            </div>

            <div class="field-group">
                <label class="field-label" for="password">كلمة المرور</label>
                <input class="form-input" type="password" id="password" name="password" required>
            </div>

            <button class="submit-btn" type="submit">تسجيل الدخول</button>
            <button class="loc-btn" type="button" id="change-db-btn">
                Change DB location
            </button>
        </form>
    </div>

    
</div>

<footer>
    <h4>ادخل على الموقع من خلال الرابط التالي</h4>
    <a href="<%= hostData %>"><%= hostData %></a>
</footer>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const changeDbBtn = document.getElementById('change-db-btn');
        
        if (changeDbBtn) {
            changeDbBtn.addEventListener('click', async () => {
                if (window.electronAPI) {
                    const newPath = await window.electronAPI.selectDbLocation();
                    
                    if (newPath) {
                        alert('تم تحديث مسار قاعدة البيانات بنجاح. سيتم إعادة تشغيل النظام لتطبيق التغييرات.');
                        window.electronAPI.restartApp(); 
                    }
                } else {
                    alert('هذه الخاصية تعمل فقط داخل تطبيق الديسكتوب الأساسي.');
                }
            });
        }
    });
</script>
</body>
</html>