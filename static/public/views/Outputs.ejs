<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الفعاليات - وزارة الاتصالات وتكنولوجيا المعلومات</title>
    <link rel="stylesheet" href="../styles/DashboardStyles.css">
    <link rel="stylesheet" href="../styles/EventStyle.css">
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" src="/images/mcit-logo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item " href="/TrainingPrograms">البرامج التدريبية Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item active" href="/Outputs">المخارج Outputs</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 class="page-title">إدارة المخرجات لمشروع: <label for=""><%= projectTitle %></label></h1>
            <div class="user-badge">
                <span class="user-name">مرحباً، <%=  username + 'المستخدم' %> </span>
            </div>
        </header>

        <section class="stats-overview">
            <div class="stat-card">
                <span class="stat-label">إجمالي المخرجات</span>
                <span class="stat-value"><%= stats.totalOutputs %></span>
            </div>
        </section>

        <section class="content-section">
            <div class="section-header">
                <h2>سجل المخرجات التفصيلي</h2>
                <a class="action-btn" href="/AddOutput">+ إضافة مخرج جديدة</a>
            </div>

            <div class="table-wrapper full-scroll">
                <table class="data-table wide-table">
                    <thead>
                        <tr>
                            <th>معرف المخرج</th>
                            <th>اسم المخرج (عربي)</th>
                            <th>اسم المخرج (إنجليزي)</th>
                            <th>تاريخ البداية</th>
                            <th>تاريخ النهاية</th>
                            <th>هدف المخرج</th>
                            <th>خط الأساس</th>
                            <th>معرف البروتوكول</th>
                            <th>معرف نوع المخرج</th>
                            <th>معرف المشروع</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (outputs && outputs.length > 0) { %>
                            <% outputs.forEach(function(output) { %>
                                <tr>
                                    <td>#<%= output.out_ID %></td>
                                    <td class="font-bold whitespace-nowrap"><%= output.out_title || '-' %></td>
                                    <td class="whitespace-nowrap"><%= output.out_title_en || '-' %></td>
                                    <td class="whitespace-nowrap"><%= new Date(output.start_date).toLocaleDateString('en-UK') || '-' %></td>
                                    <td class="cell-desc" title="<%= output.end_date %>"><%= new Date(output.end_date).toLocaleDateString('en-UK') || '-' %></td>
                                    <td><%= output.out_target || '-' %></td>
                                    <td><span class="badge"><%= output.out_baseline || 0 %></span></td>
                                    <td><%= output.protocol_id || 0 %></td>
                                    <td><%= output.out_type_id || 0 %></td>
                                    <td><%= output.pr_ID || 0 %></td>
                                    
                                    <td class="actions-cell whitespace-nowrap">
                                        <a class="table-link" href="/AddOutput/<%= output.out_ID %>">عرض</a>
                                        <a class="table-link edit" href="/AddOutput/<%= output.out_ID %>">تعديل</a>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="13" class="empty-state">لا توجد مخرجات مسجلة حالياً.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>