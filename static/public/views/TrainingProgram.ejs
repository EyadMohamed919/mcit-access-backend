<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>البرامج التدريبية - وزارة الاتصالات وتكنولوجيا المعلومات</title>
    <link rel="stylesheet" href="../styles/DashboardStyles.css">
    <link rel="stylesheet" href="../styles/EventStyle.css">
</head>
<body>
    <div id="global-loader" class="loader-overlay hidden">
        <div class="spinner"></div>
    </div>
    <script src="../scripts/loading.js"></script>

    <aside class="sidebar">
        <div class="sidebar-header">
            <img class="sidebar-logo" height="100px" src="../media/MainLogo.png" alt="شعار وزارة الاتصالات وتكنولوجيا المعلومات">
        </div>
        <nav class="sidebar-nav">
            <a class="nav-item" href="/Dashboard">المشاريع Projects</a>
            <a class="nav-item" href="/Events">الفعاليات Events</a>
            <a class="nav-item" href="/Trainees">المتدربين Trainees</a>
            <a class="nav-item active" href="/TrainingPrograms">البرامج التدريبية Training Programs</a>
            <a class="nav-item" href="/Products">المنتجات Products</a>
            <a class="nav-item" href="/Outputs">المخارج Outputs</a>

            <a class="nav-item" href="/Settings" style="margin-top: 20px;">الإعدادات Settings</a>
        </nav>
        <div class="sidebar-footer">
            <a class="logout-btn" href="/logout">تسجيل الخروج</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <h1 class="page-title">إدارة البرامج التدريبية لمشروع:  <label for=""><%= projectTitle %></label></h1>
            <div class="user-badge">
                <span class="user-name">مرحباً، <%= username || 'المستخدم' %></span>
            </div>
        </header>

        <section class="stats-overview">
            <div class="stat-card">
                <span class="stat-label">إجمالي البرامج التدريبية</span>
                <span class="stat-value"><%= programs ? programs.length : 0 %></span>
            </div>
            
        </section>

        <section class="content-section">
            <div class="section-header">
                <h2>سجل البرامج التدريبية</h2>
                <a class="action-btn" href="/AddTrainingProgram">+ إضافة برنامج جديد</a>
            </div>
        
            <div class="table-wrapper full-scroll">
                <table class="data-table wide-table">
                    <thead>
                        <tr>
                            <th>معرف البرنامج</th>
                            <th>عنوان البرنامج (عربي)</th>
                            <th>عنوان البرنامج (إنجليزي)</th>
                            <th>مدة التدريب</th>
                            <th>نوع التدريب (Type ID)</th>
                            <th>الوصف</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (programs && programs.length > 0) { %>
                            <% programs.forEach(function(program) { %>
                                <% const progId = program['Training_Program.prog_ID'] || program.prog_ID; %>
                                <% const prId = program['Projects.pr_ID'] || program.pr_ID; %>
                                <tr>
                                    <td>#<%= progId %></td>
                                    <td class="font-bold whitespace-nowrap"><%= program.prog_title || '-' %></td>
                                    <td class="whitespace-nowrap"><%= program.prog_title_En || '-' %></td>
                                    
                                    <td><span class="badge"><%= program.prog_duration || 0 %> ساعة</span></td>
                                    <td><%= program.type_id || '-' %></td>
                                    <td class="cell-desc" title="<%= program.prog_description %>">
                                        <%= program.prog_description || '-' %>
                                    </td>
                                    <td class="actions-cell whitespace-nowrap">
                                        <a class="table-link" href="/EditTrainingProgram/<%= program.prog_ID %>">تعديل</a>
                                        <form action="/api/trainingProgram/DeleteTrainingProgram" method="post">
                                            <input hidden type="number" name="trainingProgramID" value="<%= program.prog_ID %>">
                                            <button style="background: none; border: none;" class="table-link edit">حذف</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="empty-state">لا توجد برامج تدريبية مسجلة حالياً.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

</body>
</html>